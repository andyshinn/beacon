{
  "name": "beacon",
  "productName": "Beacon",
  "version": "0.1.1",
  "description": "mDNS / Bonjour / DNS-SD discovery browser",
  "author": "Andy Shinn",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andyshinn/beacon.git"
  },
  "homepage": "https://github.com/andyshinn/beacon#readme",
  "bugs": {
    "url": "https://github.com/andyshinn/beacon/issues"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "bonjour-service": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "update-electron-app": "^3.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "^2.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin --arch=universal",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "publish": "electron-forge publish",
    "icons": "tsx scripts/generate-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "smoke:discover": "tsx scripts/discover.ts"
  }
}
