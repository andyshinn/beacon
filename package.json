{
  "name": "beacon",
  "productName": "Beacon",
  "version": "0.1.1",
  "description": "mDNS / Bonjour / DNS-SD discovery browser",
  "author": "Andy Shinn",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andyshinn/beacon.git"
  },
  "homepage": "https://github.com/andyshinn/beacon#readme",
  "bugs": {
    "url": "https://github.com/andyshinn/beacon/issues"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/lexend": "^5.2.11",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "bonjour-service": "^1.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "update-electron-app": "^3.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@electron-forge/cli": "8.0.0-alpha.9",
    "@electron-forge/maker-deb": "8.0.0-alpha.9",
    "@electron-forge/maker-dmg": "8.0.0-alpha.9",
    "@electron-forge/maker-rpm": "8.0.0-alpha.9",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.9",
    "@electron-forge/maker-zip": "8.0.0-alpha.9",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.0-alpha.9",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.9",
    "@electron-forge/plugin-vite": "8.0.0-alpha.9",
    "@electron-forge/publisher-github": "8.0.0-alpha.9",
    "@electron-forge/shared-types": "8.0.0-alpha.9",
    "@electron/fuses": "^2.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^42.5.0",
    "glob": "^7",
    "happy-dom": "^20.10.6",
    "lodash": "^4.17.21",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin --arch=universal",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "publish": "electron-forge publish",
    "icons": "tsx scripts/generate-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "smoke:discover": "tsx scripts/discover.ts"
  }
}
